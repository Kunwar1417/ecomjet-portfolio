{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/sign"
    },
    {
      "source": "/outreach/",
      "destination": "https://kunwar--outreach-hq-web.modal.run/"
    },
    {
      "source": "/outreach/:path*",
      "destination": "https://kunwar--outreach-hq-web.modal.run/:path*"
    }
  ],
  "headers": [
    {
      "source": "/s/:token",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/outreach/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/media-kit-region.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/outreach",
      "destination": "/outreach/",
      "permanent": false
    }
  ]
}
